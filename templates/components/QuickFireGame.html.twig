<div{{ attributes }}>
    {% set intensityColors = {
        'warmup':   'bg-green-100 text-green-700',
        'desire':   'bg-yellow-100 text-yellow-700',
        'spark':    'bg-orange-100 text-orange-700',
        'fire':     'bg-red-100 text-red-700',
        'eruption': 'bg-purple-100 text-primary',
    } %}

    {% if this.position %}

        {# Barre de progression #}
        {% set progress = this.total > 0 ? (this.count / this.total * 100) : 0 %}
        <div class="mb-5">
            <div class="flex justify-between text-xs text-gray-400 mb-1.5">
                <span>Progression</span>
                <span>{{ this.count }} / {{ this.total }}</span>
            </div>
            <div class="h-1.5 bg-gray-200 rounded-full overflow-hidden">
                <div
                    class="h-full bg-gradient-to-r from-secondary to-tertiary rounded-full transition-all duration-500"
                    style="width: {{ progress }}%"
                ></div>
            </div>
        </div>

        {# Carte position #}
        <div class="bg-white rounded-2xl shadow-md overflow-hidden">

            {# Image avec overlay #}
            <div class="relative">
                <img
                    class="w-full aspect-3/4 object-cover max-h-[60vh]"
                    src="{{ vich_uploader_asset(this.position, 'imageFile') }}"
                    alt="{{ this.position.name }}"
                />
                {# Gradient bas #}
                <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-black/70 to-transparent"></div>
                {# Nom + badge intensité #}
                <div class="absolute bottom-0 inset-x-0 p-4 flex items-end justify-between gap-3">
                    <h2 class="text-2xl font-bold text-white drop-shadow leading-tight">{{ this.position.name }}</h2>
                    {% set intensityClass = intensityColors[this.position.intensity.value] ?? 'bg-gray-100 text-gray-700' %}
                    <span class="shrink-0 text-xs font-semibold px-2.5 py-1 rounded-full {{ intensityClass }}">
                        {{ this.position.intensity.value | trans }}
                    </span>
                </div>
            </div>

            {# Description #}
            {% if this.position.description %}
                {% set pronoun1 = this.gender1 == 'f' ? 'elle' : 'il' %}
                {% set pronoun2 = this.gender2 == 'f' ? 'elle' : 'il' %}
                {% set agreement1 = this.gender1 == 'f' ? 'e' : '' %}
                {% set agreement2 = this.gender2 == 'f' ? 'e' : '' %}
                {% set joueurHomme = this.gender1 == 'm' ? this.player1 : this.player2 %}
                {% set joueurFemme = this.gender1 == 'f' ? this.player1 : this.player2 %}
                <div class="px-5 py-4 text-gray-600 text-sm leading-relaxed border-t border-gray-100">
                    {{ this.position.description
                        |replace({
                            '{joueur1}': this.player1, '{joueur2}': this.player2,
                            '{il1}': pronoun1, '{il2}': pronoun2,
                            '{e1}': agreement1, '{e2}': agreement2,
                            '{joueurHomme}': joueurHomme, '{joueurFemme}': joueurFemme,
                        }) }}
                </div>
            {% endif %}

        </div>

        {# Bouton Suivant #}
        <div class="mt-4">
            <button
                class="w-full bg-gradient-to-r from-secondary to-tertiary text-white font-semibold py-3.5 rounded-xl hover:opacity-90 hover:cursor-pointer transition-opacity"
                data-action="live#action"
                data-live-action-param="next">
                Suivant →
            </button>
        </div>

    {% else %}

        {# Écran de fin #}
        <div class="text-center py-20">
            <div class="text-6xl mb-4">🎉</div>
            <h2 class="text-2xl font-bold text-gray-800 mb-2">Bravo !</h2>
            <p class="text-gray-500 mb-8">Vous avez terminé toutes les positions.</p>
            <button
                class="bg-gradient-to-r from-secondary to-tertiary text-white font-semibold py-3 px-8 rounded-xl hover:opacity-90 hover:cursor-pointer transition-opacity"
                data-action="live#action"
                data-live-action-param="reset">
                Rejouer 🔄
            </button>
        </div>

    {% endif %}
</div>
