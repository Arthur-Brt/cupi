{% extends 'base.html.twig' %}

{% block title %}Rafale — Préparation{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">

    {# Header #}
    <header class="bg-white border-b border-gray-100 shadow-sm">
        <div class="container mx-auto px-4 py-3 flex items-center gap-4">
            <a href="{{ path('homepage') }}" class="text-sm text-gray-400 hover:text-primary transition-colors">
                ← Accueil
            </a>
            <span class="flex-1 text-center font-bold text-gray-800">🔥 Rafale</span>
        </div>
    </header>

    <main class="container mx-auto px-4 py-8 max-w-2xl">

        <form method="post" class="flex flex-col gap-10">

            {# ── Joueurs ─────────────────────────────────────────────────── #}
            <section>
                <h1 class="text-2xl font-bold text-gray-800 mb-1 text-center">Les joueurs</h1>
                <p class="text-gray-400 text-sm text-center mb-6">Vos prénoms apparaîtront dans les descriptions des positions.</p>

                <div class="grid grid-cols-2 gap-4">
                    <div class="flex flex-col gap-1.5">
                        <label for="player1" class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Joueur 1</label>
                        <input
                            type="text"
                            id="player1"
                            name="player1"
                            value="{{ player1 }}"
                            placeholder="Prénom..."
                            maxlength="20"
                            class="w-full border-2 border-gray-200 rounded-xl px-4 py-3 text-gray-800 font-medium focus:outline-none focus:border-secondary transition-colors"
                        >
                        <select
                            id="gender1"
                            name="gender1"
                            class="w-full border-2 border-gray-200 rounded-xl px-4 py-2.5 text-gray-600 text-sm focus:outline-none focus:border-secondary transition-colors"
                        >
                            <option value="m" {% if gender1 == 'm' %}selected{% endif %}>Il</option>
                            <option value="f" {% if gender1 == 'f' %}selected{% endif %}>Elle</option>
                        </select>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label for="player2" class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Joueur 2</label>
                        <input
                            type="text"
                            id="player2"
                            name="player2"
                            value="{{ player2 }}"
                            placeholder="Prénom..."
                            maxlength="20"
                            class="w-full border-2 border-gray-200 rounded-xl px-4 py-3 text-gray-800 font-medium focus:outline-none focus:border-secondary transition-colors"
                        >
                        <select
                            id="gender2"
                            name="gender2"
                            class="w-full border-2 border-gray-200 rounded-xl px-4 py-2.5 text-gray-600 text-sm focus:outline-none focus:border-secondary transition-colors"
                        >
                            <option value="m" {% if gender2 == 'm' %}selected{% endif %}>Il</option>
                            <option value="f" {% if gender2 == 'f' %}selected{% endif %}>Elle</option>
                        </select>
                    </div>
                </div>
            </section>

            {# ── Accessoires ──────────────────────────────────────────────── #}
            <section>
                <h2 class="text-2xl font-bold text-gray-800 mb-1 text-center">Vos accessoires</h2>
                <p class="text-gray-400 text-sm text-center mb-6">Sélectionnez les accessoires disponibles ce soir.<br>Les positions sans accessoires sont toujours incluses.</p>

                {% if accessories is empty %}
                    <p class="text-center text-gray-400 py-10">Aucun accessoire disponible.</p>
                {% else %}
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                        {% for accessory in accessories %}
                            {% set isSelected = accessory.id in selectedIds %}
                            <label class="relative cursor-pointer">
                                <input
                                    type="checkbox"
                                    name="accessories[]"
                                    value="{{ accessory.id }}"
                                    class="sr-only peer"
                                    {% if isSelected %}checked{% endif %}
                                >
                                <div class="flex flex-col items-center gap-2 p-4 bg-white rounded-2xl border-2 border-gray-100 transition-all duration-150
                                            peer-checked:border-secondary peer-checked:bg-secondary/5
                                            hover:border-gray-200 hover:shadow-sm">
                                    {% if accessory.imageName %}
                                        <img
                                            src="/uploads/accessories/{{ accessory.imageName }}"
                                            alt="{{ accessory.name }}"
                                            class="w-16 h-16 object-cover rounded-xl"
                                        >
                                    {% else %}
                                        <div class="w-16 h-16 rounded-xl bg-gray-100 flex items-center justify-center text-2xl">🎁</div>
                                    {% endif %}
                                    <span class="text-sm font-medium text-gray-700 text-center leading-tight">{{ accessory.name }}</span>
                                </div>
                                <div class="absolute top-2 right-2 w-5 h-5 rounded-full bg-secondary text-white text-xs items-center justify-center hidden peer-checked:flex">✓</div>
                            </label>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>

            {# ── Actions ──────────────────────────────────────────────────── #}
            <div class="flex flex-col gap-3">
                <button
                    type="submit"
                    class="w-full bg-gradient-to-r from-secondary to-tertiary text-white font-semibold py-3.5 rounded-xl hover:opacity-90 transition-opacity cursor-pointer">
                    Jouer →
                </button>
                <a
                    href="{{ path('app_quick_fire') }}"
                    class="w-full text-center text-sm text-gray-400 hover:text-gray-600 py-2 transition-colors">
                    Jouer sans configuration
                </a>
            </div>

        </form>

    </main>
</div>
{% endblock %}
